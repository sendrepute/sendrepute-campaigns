# Copying this file is not the standard setup path. Run ./install.sh instead.
CAMPAIGNS_BIND_ADDRESS=127.0.0.1
CAMPAIGNS_HTTP_PORT=8080
CAMPAIGNS_TRUST_PROXY=false
# For public HTTPS: set a real DNS hostname, enable trust of the included proxy,
# then run docker compose --profile https up -d --build.
# CAMPAIGNS_DOMAIN=campaigns.example.com
# Or enter the domain in Workspace Settings and start the same HTTPS Compose
# profile. Set CAMPAIGNS_TRUST_PROXY=true only behind the bundled Caddy proxy.
